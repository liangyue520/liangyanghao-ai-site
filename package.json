{
  "name": "liangyanghao-ai-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "server": "tsx server/main.ts",
    "init:local": "tsx scripts/init-local.ts",
    "admin": "tsx scripts/admin.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "check:tools": "tsx scripts/check-tools.ts",
    "verify:restart": "tsx scripts/verify-restart.ts",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "stop:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.4",
    "archiver": "7.0.1",
    "fastify": "5.12.5",
    "file-type": "22.1.1",
    "pdfjs-dist": "6.3.289",
    "sharp": "0.35.4",
    "vue": "3.5.43",
    "vue-router": "4.6.4",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "7.0.0",
    "@types/node": "24.13.6",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-vue": "6.0.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  }
}
