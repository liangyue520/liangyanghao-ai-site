# Local only. Select dev/e02/e03/e04 through --env; never put secrets in VITE_*.
SITE_ENV=dev
# Browser retry policy (public build-time settings; do not put secrets in VITE_*).
VITE_REQUEST_MAX_RETRIES=5
VITE_REQUEST_RETRY_BASE_MS=250
VITE_REQUEST_RETRY_MAX_MS=4000
# Optional absolute path to locally verified ffprobe executable
# FFPROBE_PATH=/absolute/path/to/ffprobe
# Set VITE_ENABLE_ANALYTICS=false when deploying without the analytics API.
# VITE_ENABLE_ANALYTICS=false
# Public footer settings. The default start date is 2026-11-02 (Asia/Shanghai).
# VITE_SITE_STARTED_AT=2026-11-02
# Optional override for the public, read-only statistics endpoint. Defaults to the first-party backend. Never put authentication secrets in VITE_*.
# Returns {"todayVisitors":0,"todayPageviews":0,"totalVisitors":0,"totalPageviews":0}.
# VITE_PUBLIC_SITE_STATS_URL=https://example.com/public-site-stats
